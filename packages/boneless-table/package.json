{
  "name": "boneless-table",
  "version": "0.1.1",
  "description": "A typed, accessible, virtualized, unstyled data table renderer for React built on TanStack Table.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexRapala/boneless-table.git",
    "directory": "packages/boneless-table"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "lint": "eslint src tests tsup.config.ts vitest.config.mts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
